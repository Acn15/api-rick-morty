# Database — use um Postgres gerenciado (Neon, Vercel Postgres, Supabase, etc.).
# O Docker Compose NÃO sobe mais o banco local (serviços db/db-dev comentados).
#
# Postgres no Docker (legado — desabilitado):
# POSTGRES_HOST=db-dev
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=bestjs
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Exemplo com banco externo:
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Application
NODE_ENV=development
PORT=3000

# CORS — origens de browser permitidas (credentials), separadas por vírgula, sem espaço após a vírgula ou use espaços trimados
# Produção: inclua o front (ex.: https://app.seudominio.com). Mobile nativo costuma não enviar Origin e segue permitido.
# Dev/Expo Web local: pode omitir e o servidor reflete qualquer Origin; em prod omitir emite aviso no log.
# CORS_ORIGINS=https://app.seudominio.com,https://www.seudominio.com

# Security — required at boot (no hardcoded fallbacks)
# JWT_SECRET: always required (used for signing and verifying tokens)
JWT_SECRET=change-me-to-a-long-random-jwt-secret
# CSRF_SECRET: required when CSRF is enabled (production by default, or ENABLE_CSRF=true in dev)
CSRF_SECRET=change-me-to-a-long-random-csrf-secret

# Development: disables CSRF so CSRF_SECRET is not enforced. Remove / set false in production.
DISABLE_CSRF=true
# ENABLE_CSRF=true

# Integrations
RICK_AND_MORTY_API_BASE_URL=https://rickandmortyapi.com/api

# Redis / Cache
REDIS_HOST=redis-dev
REDIS_PORT=6379
REDIS_PUBLISHED_PORT=6379
# REDIS_PASSWORD=
EPISODES_CACHE_TTL_SECONDS=3600
CHARACTERS_CACHE_TTL_SECONDS=3600
